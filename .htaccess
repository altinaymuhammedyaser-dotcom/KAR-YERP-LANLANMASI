# =====================================================================
# AKILLI KARİYER - Apache yapılandırması
# =====================================================================

# Dizin listelemesini kapat
Options -Indexes

# Varsayılan karakter kümesi
AddDefaultCharset UTF-8

# ---------------------------------------------------------------
# Dizin yönlendirmeleri
# ---------------------------------------------------------------
DirectoryIndex index.php index.html

# ---------------------------------------------------------------
# Hassas dosyalara doğrudan erişimi engelle
# ---------------------------------------------------------------
<FilesMatch "\.(sql|log|ini|env|md|sh|json)$">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------
# Gizli klasörler
# ---------------------------------------------------------------
RedirectMatch 403 ^/(app|config|tools|storage/logs|storage/cache)(/|$)

# ---------------------------------------------------------------
# Güvenlik başlıkları
# ---------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ---------------------------------------------------------------
# Özel hata sayfaları
# ---------------------------------------------------------------
ErrorDocument 403 /404.php
ErrorDocument 404 /404.php

# ---------------------------------------------------------------
# Dosya tipi tanımları
# ---------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType application/font-woff2 .woff2
    AddType application/vnd.ms-fontobject .eot
</IfModule>

# ---------------------------------------------------------------
# Sıkıştırma
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------
# Tarayıcı önbelleği
# ---------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
</IfModule>

# ---------------------------------------------------------------
# PHP ayarları (Apache üzerinden)
# ---------------------------------------------------------------
<IfModule mod_php.c>
    php_value upload_max_filesize 4M
    php_value post_max_size 8M
    php_flag display_errors off
    php_flag log_errors on
</IfModule>
